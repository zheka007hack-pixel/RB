# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server port (default: 3000)
PORT=3000

# Sub-path prefix when hosting under a nested URL, e.g. /rb
# Leave empty (default) to serve from the root: https://domain.tld/
# Set to /rb to serve from:               https://domain.tld/rb/
# Must match VITE_BASE_PATH — both are set at build time via this file.
BASE_PATH=
VITE_BASE_PATH=

# SQLite database path (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# JWT Secret for authentication
JWT_SECRET="super_secret_jwt_key_change_me_in_production"

# Superadmin login (Bypasses all role restrictions)
SUPERADMIN_LOGIN="admin"

# Time (in hours) a boss stays ALIVE before resetting to UNKNOWN
ALIVE_TIMEOUT_HOURS="4"
VITE_ALIVE_TIMEOUT_HOURS="4"

# Express trust proxy setting for req.ip. Default trusts loopback reverse proxies only.
TRUST_PROXY="loopback"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Telegram Bot credentials for "Login with Telegram" widget
# Create a bot via @BotFather, then set the domain with /setdomain
TELEGRAM_BOT_TOKEN="your_bot_token_here"
VITE_TELEGRAM_BOT_USERNAME="your_bot_username_here"
